{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified_credit_report.schema.json",
  "title": "Unified Credit Report Schema",
  "description": "A minimal unified schema for individual and corporate credit-report Q&A.",
  "type": "object",
  "required": [
    "schema_version",
    "report_type",
    "source_files",
    "report_meta",
    "basic_profile",
    "derived_metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for compatibility management."
    },
    "report_type": {
      "type": "string",
      "enum": [
        "individual",
        "corporate"
      ]
    },
    "source_files": {
      "type": "array",
      "description": "Input files used to build the normalized JSON.",
      "items": {
        "$ref": "#/$defs/sourceFile"
      },
      "minItems": 1
    },
    "report_meta": {
      "$ref": "#/$defs/reportMeta"
    },
    "basic_profile": {
      "$ref": "#/$defs/basicProfile"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "addresses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/address"
      }
    },
    "employment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/employmentRecord"
      }
    },
    "shareholders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shareholderRecord"
      }
    },
    "management": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/managementRecord"
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controllerRecord"
      }
    },
    "loan_accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loanAccount"
      }
    },
    "credit_card_accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creditCardAccount"
      }
    },
    "credit_lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creditLine"
      }
    },
    "guarantee_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guaranteeRecord"
      }
    },
    "query_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queryRecord"
      }
    },
    "dispute_records": {
      "type": "array",
